# Privacy guard: personal media (photos, narration with the baby's name, the final mix) never goes in git.
media/
*.private.*
assets/private/
node_modules/
.DS_Store

# Rendered demo reels / exports (large; shared outside the repo)
*.mp4
# …except the app's character clips (original/PD characters, no personal data; WP-04, owner OK)
!app/assets/clips/*.mp4

# Music files (kept on the device; see assets/CREDITS.md)
*.mp3
*.ogg
*.wav
